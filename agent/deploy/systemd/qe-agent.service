# /etc/systemd/system/qe-agent.service — one sync run (started by qe-agent.timer).
#   install -d -o qe-agent -g qe-agent -m 0700 /var/lib/qe-agent
#   install -m 0444 qe-agent.mjs SHA256SUMS /opt/qe-agent/
#   /etc/qe-agent/qe-agent.yaml (0644) and /etc/qe-agent/env (0600: QE_API_KEY=…, JIRA_TOKEN=…)
#   systemctl daemon-reload && systemctl enable --now qe-agent.timer
#   journalctl -u qe-agent        # structured JSON logs, no secrets
[Unit]
Description=QE Navigator on-premises agent (one sync run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=qe-agent
Group=qe-agent
EnvironmentFile=/etc/qe-agent/env
Environment=QE_AGENT_CONFIG=/etc/qe-agent/qe-agent.yaml
ExecStart=/usr/bin/node /opt/qe-agent/qe-agent.mjs sync --log-format json
TimeoutStartSec=50min
# Exit codes 2–6 are reported failures (config, source, QE Navigator, locked, partial): see README.
SuccessExitStatus=0
# Hardening: read-only system, only the state directory is writable, no privileges, outbound only.
StateDirectory=qe-agent
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
