# Settings for the UI test runners. Copy to .env.test (never commit .env.test).
# The runners never read your .env: the API and web app started for the tests get only these
# values plus fixed test settings.

# npm run test:ui:local
# A Postgres on THIS machine to use instead of Docker. Only localhost / 127.0.0.1 is accepted, and the
# database name must contain "test": it is dropped and created again on every run (unless --reuse-db).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/irongate_ui_test

# Optional: the JWT secret of the test API (a random one is used otherwise).
# TEST_JWT_SECRET=local-ui-tests-only

# npm run test:ui:remote -- --base-url https://... --i-understand-this-is-live
# The account the read-only checks sign in with on the live site.
# UI_REMOTE_EMAIL=
# UI_REMOTE_PASSWORD=
