{
  "name": "irongate-qa-navigator",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise-grade Quality Assurance Intelligence Platform",
  "license": "LICENSED",
  "author": "IronGate Software LTD",
  "copyright": "Copyright (c) 2025 IronGate Software LTD. All rights reserved.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "dev": "vite",
    "docs:pdf": "node docs/pdf/build.mjs",
    "docs:pdf:screens": "node docs/pdf/screens.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "server:prod": "tsx server/index.ts",
    "seed:demo": "tsx server/seeds/demoSeedCli.ts",
    "seed:demo:clear": "tsx server/seeds/demoSeedCli.ts --clear",
    "seed:demo:check": "tsx server/seeds/demoCheck.ts",
    "operator:create": "tsx server/scripts/operatorCreate.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --config jest.config.cjs",
    "test:api": "jest --config jest.config.cjs tests/api",
    "test:db": "jest --config jest.config.cjs tests/database",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --project=chromium --headed --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed --workers=1",
    "test:e2e:debug": "playwright test --debug",
    "test:ui:local": "node scripts/ui-tests/run-local.mjs",
    "test:ui:local:smoke": "node scripts/ui-tests/run-local.mjs --smoke",
    "test:ui:local:headed": "node scripts/ui-tests/run-local.mjs --headed --workers 1",
    "test:ui:local:ui": "node scripts/ui-tests/run-local.mjs --ui",
    "test:ui:local:report": "playwright show-report",
    "test:ui:remote": "node scripts/ui-tests/run-remote.mjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:watch": "jest --config jest.config.cjs --watch",
    "playwright:install": "playwright install chromium",
    "playwright:report": "playwright show-report",
    "secrets:reencrypt": "tsx server/scripts/reencryptSecrets.ts"
  },
  "dependencies": {
    "@netlify/functions": "^5.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.554.0",
    "node-cron": "^4.2.1",
    "nodemailer": "9.1.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.4.1",
    "serverless-http": "^4.0.0",
    "sweetalert2": "^11.26.3",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
}
