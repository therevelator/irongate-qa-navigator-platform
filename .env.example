# IronGate QA Navigator - Environment Variables
# Copy this file to .env and fill in your actual API credentials

# ============================================================================
# DATABASE CONFIGURATION (Required for Backend)
# ============================================================================
# PostgreSQL (Supabase). Use the pooler connection string from
# Supabase → Project Settings → Database → Connection pooling (Transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Local Postgres example (SSL is disabled automatically for localhost):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irongate_qa

# Optional: max connections per server/function instance (default 10, or 3 on Netlify)
# DB_POOL_MAX=3

# ============================================================================
# JWT SECRET (Required for Authentication)
# ============================================================================
JWT_SECRET=your-random-secret-key-here

# Generate a secure secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ============================================================================
# METRIC DATA SOURCES
# ============================================================================
# There are no built-in Jenkins / Jira / SonarQube / GitHub / TestRail / Datadog connectors.
# Send data from your own tools with an API key created in the Admin console (one key works for
# every ingestion route). Raw reports, from which the app computes the metrics:
#   POST /api/ingest/tests            test reports (JUnit XML, TRX, Cucumber JSON)
#   POST /api/ingest/coverage         coverage reports (lcov, Cobertura, JaCoCo, Istanbul JSON)
#   POST /api/ingest/pipelines        CI pipeline run events with stages
#   POST /api/ingest/deployments      deployments
#   POST /api/ingest/commits          commits
#   POST /api/ingest/incidents        incidents
#   POST /api/ingest/issues           issue tracker data (Jira, Linear)
#   POST /api/ingest/static-analysis  static analysis results (SARIF 2.1.0)
# Already computed KPI values: POST /api/ingest/kpis. Details: docs/INTEGRATION_GUIDE.md.
# Never put tool credentials in VITE_* variables: anything prefixed VITE_ is bundled into the
# browser JavaScript.

# Optional: generate sample (synthetic) data on the server. Off unless set to true.
# ENABLE_SYNTHETIC_DATA=false

# ============================================================================
# GROQ AI CONFIGURATION (For AI-powered team suggestions)
# ============================================================================
GROQ_API_KEY=your-groq-api-key-here

# How to get Groq API key:
# 1. Go to https://console.groq.com/
# 2. Sign up or log in
# 3. Go to API Keys section
# 4. Create a new API key and copy it

# ============================================================================
# E-MAIL (invitations, password resets, pulse surveys, alerts, weekly digest)
# ============================================================================
# The first configured channel wins: Resend, then SMTP; with neither, e-mails are only
# written to the server log.
# Resend (https://resend.com): verify your sending domain under Domains first, then create
# an API key with "Sending access". MAIL_FROM must use the verified domain.
# RESEND_API_KEY=re_your_key_here
# MAIL_FROM=IronGate QE Navigator <no-reply@yourdomain.com>
# SMTP instead of Resend (SMTP_FROM is also the fallback sender for Resend):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=IronGate QE Navigator <no-reply@yourdomain.com>
# Public URL of the app, used in the links of every e-mail (on Netlify defaults to URL):
# APP_URL=https://qe.yourdomain.com

# ============================================================================
# NIGHTLY DEMO REFRESH (Netlify only; netlify/functions/demo-refresh*.ts)
# ============================================================================
# Adds the missing recent days of sample data every night at 02:17 UTC.
# Never touches real data. Set to false on a deployment without demo data.
# DEMO_REFRESH_ENABLED=true
# Optional: signs the call to the background function (falls back to JWT_SECRET)
# DEMO_REFRESH_SECRET=a-long-random-string

# ============================================================================
# PLATFORM OPERATOR PANEL (/operator, product owner only)
# ============================================================================
# Operators are rows of the platform_operators table, not an environment variable: create one
# with `npm run operator:create -- --email ... --name "..."`. No active operator = the feature is
# off (every /api/operator route answers 404).
# Optional: only these client IPs may use it (comma-separated).
# PLATFORM_OPERATOR_ALLOWED_IPS=203.0.113.10

# ============================================================================
# NOTES
# ============================================================================
# - Keep this file secure and never commit it to version control
# - The .env file is already in .gitignore
# - Only variables prefixed with VITE_ reach the frontend, and they are public; keep secrets server-side
